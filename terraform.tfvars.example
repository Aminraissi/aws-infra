# ── Copier ce fichier en terraform.tfvars et remplir les valeurs ──
# cp terraform.tfvars.example terraform.tfvars

aws_region         = "eu-west-1"
project_name       = "online-boutique"
cluster_name       = "online-boutique"
cluster_version    = "1.32"
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["eu-west-1a", "eu-west-1b"]
domain_name        = "raissiamine.click"
www_domain         = "www.raissiamine.click"
app_namespace      = "default"
app_service_name   = "frontend"
app_service_port   = 80
health_check_path  = "/_healthz"
account_id         = "YOUR_ACCOUNT_ID"
lbc_version        = "1.7.2"

# ALB DNS - obtenu après kubectl get ingress
alb_dns_name = ""

# Langfuse - obtenu sur cloud.langfuse.com
langfuse_public_key = "pk-lf-..."
langfuse_secret_key = "sk-lf-..."
